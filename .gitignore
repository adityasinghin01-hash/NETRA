# Dependencies
node_modules/

# Environment variables (NEVER commit real secrets)
# INFO-01 FIX: Cover all common .env variants, not just .env
.env
.env.local
.env.*.local
.env.test
.env.production

# Build output
frontend/dist/
dist/
build/

# Test scripts (local only)
_test_*.js
_debug_*.js

# Test coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Local one-off scripts (seeds, migrations run interactively — not CI)
scripts/*.local.js

# Local AI session log — kept local so reusable-backend consumers don't
# inherit project-specific session narration.
history

# NETRA generated dataset (reproducible via pipeline/generator; do not commit the bulk)
pipeline/data/

# Catalyst build output + logs (client/ is regenerated by scripts/deploy-client.sh)
client/
catalyst-debug.log
.catalyst/

# Catalyst import CSVs (regenerated by pipeline/export_catalyst.py)
pipeline/data/catalyst/

# Function dependencies (reinstalled on deploy)
functions/*/node_modules/

# Blind-test secret patterns (never commit — keeps the test honest)
pipeline/blindtest/patterns.txt

# Pre-rendered briefing audio (reproducible via pipeline/build_briefing_audio.py; ~21MB, do not commit)
frontend/public/audio/
